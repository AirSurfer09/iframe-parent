# Password for protected pages/routes
PAGE_ACCESS_PASSWORD=password

# Experience ID shown in the demo on the home page
NEXT_PUBLIC_EXP_ID=your_experience_id_here

# Convai service URLs — set these per environment in Vercel dashboard
# STG values:
#   NEXT_PUBLIC_PIXEL_STREAM_BASE=https://x-preview.convai.com
#   NEXT_PUBLIC_SESSION_FETCH_URL=https://api-preview.convai.com
# Production values:
#   NEXT_PUBLIC_PIXEL_STREAM_BASE=https://x.convai.com
#   NEXT_PUBLIC_SESSION_FETCH_URL=https://api.convai.com
NEXT_PUBLIC_PIXEL_STREAM_BASE=https://x-preview.convai.com
NEXT_PUBLIC_SESSION_FETCH_URL=https://api-preview.convai.com
