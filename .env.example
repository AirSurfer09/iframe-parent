# Password for protected pages/routes (full build only)
PAGE_ACCESS_PASSWORD=password

# Experience ID shown in the demo on the home page
NEXT_PUBLIC_EXP_ID=your_experience_id_here

# Convai service URLs — set these per environment in the Vercel dashboard
# STG values:
#   NEXT_PUBLIC_PIXEL_STREAM_BASE=https://x-preview.convai.com
#   NEXT_PUBLIC_SESSION_FETCH_URL=https://api-preview.convai.com
# Production values:
#   NEXT_PUBLIC_PIXEL_STREAM_BASE=https://x.convai.com
#   NEXT_PUBLIC_SESSION_FETCH_URL=https://api.convai.com
NEXT_PUBLIC_PIXEL_STREAM_BASE=https://x-preview.convai.com
NEXT_PUBLIC_SESSION_FETCH_URL=https://api-preview.convai.com

# ---------------------------------------------------------------------------
# Client deliverable (the Docker image — see Dockerfile and docker/README.md)
# ---------------------------------------------------------------------------
# Builds the stripped-down page: thin title bar + embed only. No nav, footer,
# integration guide, newsletter, debug controls or Convai-internal identity.
NEXT_PUBLIC_CLIENT_MODE=false

# Title shown in the thin header and the browser tab of the client build
NEXT_PUBLIC_APP_TITLE=Convai Pixel Streaming

# Optional end-user identifier passed to the embed
NEXT_PUBLIC_END_USER_ID=
